{
  "name": "aixiliary-backend",
  "version": "1.0.0",
  "description": "Backend API for AIxiliary file classification system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "migrate": "psql $DATABASE_URL -f database/schema.sql"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@langchain/core": "^0.1.20",
    "@langchain/openai": "^0.0.14",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "langchain": "^0.1.20",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.26.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "connect-pg-simple": "^9.0.1",
    "connect-redis": "^7.1.0",
    "redis": "^4.6.12",
    "@azure/storage-blob": "^12.17.0",
    "applicationinsights": "^2.9.1",
    "pm2": "^5.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
